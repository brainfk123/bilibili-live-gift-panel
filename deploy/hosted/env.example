# Requires Docker Compose 2.33.1+ for deterministic egress gateway selection.
# Validate from the repository root with:
# docker compose --env-file deploy/hosted/env.example -f deploy/hosted/docker-compose.yml config
# Copy to /etc/gift-panel-hosted/env and replace paths/host-specific public values.
# This file contains no credential values. Secret variables point to root-managed files.
HOSTED_IMAGE=gift-panel-hosted:test
HOSTED_ADMIN_ALLOWED_ORIGIN=https://hosted.example.invalid
HOSTED_MYSQL_DATABASE=gift_panel
HOSTED_MYSQL_USER=gift_panel
HOSTED_SMTP_ADDRESS=smtp.example.invalid:587
HOSTED_SMTP_HOST=smtp.example.invalid
HOSTED_SMTP_USERNAME=gift-panel-hosted
HOSTED_SMTP_FROM=gift-panel-hosted@example.invalid
HOSTED_SMTP_MODE=starttls
HOSTED_MYSQL_ROOT_PASSWORD_FILE=/etc/gift-panel-hosted/secrets/mysql-root-password
HOSTED_MYSQL_PASSWORD_FILE=/etc/gift-panel-hosted/secrets/mysql-password
HOSTED_MYSQL_DSN_FILE=/etc/gift-panel-hosted/secrets/mysql-dsn
HOSTED_ENCRYPTION_KEY_FILE=/etc/gift-panel-hosted/secrets/encryption-key
HOSTED_HMAC_KEY_FILE=/etc/gift-panel-hosted/secrets/hmac-key
HOSTED_ADMIN_CSRF_TOKEN_FILE=/etc/gift-panel-hosted/secrets/admin-csrf-token
HOSTED_SMTP_PASSWORD_FILE=/etc/gift-panel-hosted/secrets/smtp-password
